// ------------------------------------------------------
// PROFILE
// ------------------------------------------------------

function ProfilePage({
  profile,
  setProfile,
}: {
  profile: ProfileState;
  setProfile: React.Dispatch<React.SetStateAction<ProfileState>>;
}) {
  const [saved, setSaved] = useState(false);

  const saveProfile = (e: React.FormEvent) => {
    e.preventDefault();
    setSaved(true);
    window.setTimeout(() => setSaved(false), 2500);
  };

  return (
    <div className="space-y-6">
      <p className="text-sm text-slate-500">
        Manage your demonstration profile.
      </p>

      <div className={`${cardStyle} flex items-center gap-4`}>
        <div className="flex h-16 w-16 items-center justify-center rounded-2xl bg-[#DCEBFF] text-[#2563EB]">
          <UserRound size={30} />
        </div>
        <div>
          <h3 className="font-bold">{profile.name || "Your profile"}</h3>
          <p className="text-sm text-slate-500">Patient account</p>
        </div>
      </div>

      <form
        onSubmit={saveProfile}
        className="max-w-2xl space-y-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7"
      >
        <h3 className="font-bold">Personal information</h3>

        <FormField label="Full name">
          <input
            className={inputStyle}
            value={profile.name}
            onChange={(e) =>
              setProfile((previous) => ({
                ...previous,
                name: e.target.value,
              }))
            }
          />
        </FormField>

        <FormField label="Phone number">
          <input
            className={inputStyle}
            value={profile.phone}
            onChange={(e) =>
              setProfile((previous) => ({
                ...previous,
                phone: e.target.value,
              }))
            }
            placeholder="Your phone number"
          />
        </FormField>

        <FormField label="Preferred language">
          <select
            className={inputStyle}
            value={profile.preferredLanguage}
            onChange={(e) =>
              setProfile((previous) => ({
                ...previous,
                preferredLanguage: e.target.value,
              }))
            }
          >
            <option>English</option>
            <option>Arabic</option>
            <option>Acholi</option>
            <option>Swahili</option>
            <option>Other</option>
          </select>
        </FormField>

        <FormField label="Health facility">
          <input
            className={inputStyle}
            value={profile.facility}
            onChange={(e) =>
              setProfile((previous) => ({
                ...previous,
                facility: e.target.value,
              }))
            }
          />
        </FormField>

        <button type="submit" className={primaryButtonStyle}>
          <CheckCircle2 size={17} />
          Save profile
        </button>

        {saved && (
          <p className="flex items-center gap-2 text-sm text-[#2563EB]">
            <CheckCircle2 size={17} />
            Profile updated in this session.
          </p>
        )}
      </form>
    </div>
  );
}

// ------------------------------------------------------
// REFERRALS
// ------------------------------------------------------

function ReferralsPage({ patientUid }: { patientUid: string }) {
  const [referrals, setReferrals] = useState<Referral[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [refreshKey, setRefreshKey] = useState(0);

  useEffect(() => {
    let active = true;

    async function loadReferrals() {
      setLoading(true);
      setError("");

      try {
        const results = await getPatientReferrals(patientUid);
        if (active) {
          setReferrals(results);
        }
      } catch (err) {
        console.error("Unable to load patient referrals:", err);
        if (active) {
          setError("We could not load your referrals. Please try again.");
        }
      } finally {
        if (active) {
          setLoading(false);
        }
      }
    }

    if (!patientUid) {
      setError("Your patient account could not be identified.");
      setLoading(false);
    } else {
      void loadReferrals();
    }

    return () => {
      active = false;
    };
  }, [patientUid, refreshKey]);

  const statusStyle = (status: Referral["status"]) => {
    switch (status) {
      case "accepted":
        return "bg-blue-100 text-blue-700";
      case "completed":
        return "bg-green-100 text-green-700";
      case "cancelled":
        return "bg-red-100 text-red-700";
      default:
        return "bg-amber-100 text-amber-700";
    }
  };

  return (
    <div className="space-y-6">
      <div className="flex flex-wrap items-center justify-between gap-3">
        <p className="text-sm text-slate-500">
          View referrals and follow-up care from your healthcare team.
        </p>
        <button
          type="button"
          onClick={() => setRefreshKey((value) => value + 1)}
          disabled={loading}
          className="rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 disabled:opacity-50"
        >
          {loading ? "Loading..." : "Refresh"}
        </button>
      </div>

      <div className={cardStyle}>
        <div className="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-blue-700">
          <FileText size={23} />
        </div>

        <h3 className="font-bold">Your referrals</h3>
        <p className="mt-2 text-sm leading-6 text-slate-500">
          Referrals and follow-up information assigned by your healthcare team.
        </p>

        {loading && (
          <p className="mt-6 text-sm text-slate-500">
            Loading your referrals...
          </p>
        )}

        {!loading && error && (
          <div className="mt-5 rounded-xl border border-red-200 bg-red-50 p-4">
            <p className="text-sm text-red-700">{error}</p>
            <button
              type="button"
              onClick={() => setRefreshKey((value) => value + 1)}
              className="mt-3 text-sm font-semibold text-red-700 underline"
            >
              Try again
            </button>
          </div>
        )}

        {!loading && !error && referrals.length === 0 && (
          <div className="mt-5">
            <EmptyState text="You do not have any referrals yet." />
          </div>
        )}

        {!loading && !error && referrals.length > 0 && (
          <div className="mt-6 space-y-4">
            {referrals.map((referral) => (
              <article
                key={referral.id}
                className="rounded-xl border border-slate-200 p-4"
              >
                <div className="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <h4 className="font-semibold text-slate-800">
                      {referral.destination}
                    </h4>
                    <p className="mt-1 text-xs text-slate-400">
                      Referral ID: {referral.id}
                    </p>
                  </div>
                  <span
                    className={`rounded-full px-3 py-1 text-xs font-semibold capitalize ${statusStyle(referral.status)}`}
                  >
                    {referral.status}
                  </span>
                </div>

                {referral.notes && (
                  <p className="mt-4 whitespace-pre-wrap text-sm leading-6 text-slate-600">
                    {referral.notes}
                  </p>
                )}

                {referral.createdAt && (
                  <p className="mt-4 text-xs text-slate-400">
                    Created: {referral.createdAt.toDate().toLocaleDateString()}
                  </p>
                )}
              </article>
            ))}
          </div>
        )}
      </div>
    </div>
  );
}

