
import { useEffect, useState } from "react";
import {
  Activity, CalendarDays, Bell, MessageCircle, HeartPulse, Home,
  UserRound, Menu, X, Plus, Clock, ChevronRight, ShieldCheck,
  Stethoscope, Send, Trash2, CheckCircle2, BookOpen, CalendarCheck,
  Leaf, FileText, Inbox, LockKeyhole, CircleHelp, MoreHorizontal,
  Phone, Mail, MapPin, ArrowRight, Shield,
} from "lucide-react";
import type { Appointment as FirestoreAppointment, Message as FirestoreMessage, Referral, UserProfile } from "./types";
import { getPatientReferrals } from "./services/referrals";
import { createAppointment, getPatientAppointments, updateAppointmentStatus } from "./services/appointments";
import { getOrCreatePatientConversation, sendMessage as sendFirebaseMessage, subscribeToConversationMessages } from "./services/messages";

// ------------------------------------------------------
// TYPES
// ------------------------------------------------------

type Page =
  | "Dashboard"
  | "Appointments"
  | "Reminders"
  | "Messages"
  | "Health Information"
  | "My Profile"
  | "Referrals"
  | "Notifications"
  | "Privacy & Consent"
  | "Help & Support"
  | "Settings";

type Appointment = FirestoreAppointment;

type Message = {
  id: string;
  text: string;
  sender: "patient" | "worker";
  time: string;
};

type ProfileState = {
  name: string;
  phone: string;
  preferredLanguage: string;
  facility: string;
};

// ------------------------------------------------------
// NAVIGATION
// ------------------------------------------------------

const navigation: { name: Page; icon: typeof Home }[] = [
  { name: "Dashboard", icon: Home },
  { name: "Appointments", icon: CalendarDays },
  { name: "Reminders", icon: Bell },
  { name: "Messages", icon: MessageCircle },
  { name: "Health Information", icon: HeartPulse },
  { name: "My Profile", icon: UserRound },
  { name: "Referrals", icon: FileText },
  { name: "Notifications", icon: Inbox },
  { name: "Privacy & Consent", icon: LockKeyhole },
  { name: "Help & Support", icon: CircleHelp },
  { name: "Settings", icon: MoreHorizontal },
];

// ------------------------------------------------------
// INITIAL DATA
// ------------------------------------------------------

const initialMessages: Message[] = [
  {
    id: "welcome",
    text: "Welcome to SANAD CareLink. You can use this space to send a message to your healthcare worker in this demonstration.",
    sender: "worker",
    time: "Today",
  },
];

const healthTopics = [
  {
    title: "Antenatal Care",
    description:
      "Regular antenatal visits help monitor your pregnancy and give you an opportunity to ask questions and receive support.",
    icon: CalendarCheck,
  },
  {
    title: "Nutrition During Pregnancy",
    description:
      "Eat a variety of nutritious foods, drink clean water, and follow advice from your healthcare worker.",
    icon: Leaf,
  },
  {
    title: "Maternal Wellbeing",
    description:
      "Rest when you can, talk to someone you trust, and seek support when you feel overwhelmed.",
    icon: HeartPulse,
  },
  {
    title: "Birth Preparation",
    description:
      "Discuss your birth plan, transport arrangements, and where to seek care with your healthcare worker.",
    icon: Stethoscope,
  },
];

// ------------------------------------------------------
// STORAGE AND HELPERS
// ------------------------------------------------------

const readStorage = <T,>(key: string, fallback: T): T => {
  try {
    const saved = localStorage.getItem(key);
    return saved ? (JSON.parse(saved) as T) : fallback;
  } catch {
    return fallback;
  }
};

const inputStyle =
  "w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-800 outline-none transition-all duration-200 placeholder:text-slate-400 focus:border-[#2563EB] focus:ring-4 focus:ring-[#2563EB]/10";

const cardStyle =
  "rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-all duration-200 hover:shadow-md sm:p-6";

const primaryButtonStyle =
  "inline-flex items-center justify-center gap-2 rounded-xl bg-[#2563EB] px-5 py-3 text-sm font-semibold text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#123B73] hover:shadow-md active:translate-y-0 disabled:cursor-not-allowed disabled:opacity-40";

const todayString = () => new Date().toISOString().split("T")[0];

// ------------------------------------------------------
// MAIN APPLICATION
// ------------------------------------------------------

function App({ authenticatedProfile, onSignOut }: { authenticatedProfile: UserProfile; onSignOut: () => void }) {
  const [page, setPage] = useState<Page>("Dashboard");
  const [mobileMenu, setMobileMenu] = useState(false);

  const [appointments, setAppointments] = useState<Appointment[]>([]);
  const [appointmentsLoading, setAppointmentsLoading] = useState(true);
  const [appointmentsError, setAppointmentsError] = useState("");

  const loadAppointments = async () => {
    try {
      setAppointmentsError("");
      const records = await getPatientAppointments(authenticatedProfile.uid);
      setAppointments(records);
    } catch (error) {
      console.error("Unable to load patient appointments:", error);
      setAppointmentsError(
        error instanceof Error ? error.message : "Unable to load appointments."
      );
    } finally {
      setAppointmentsLoading(false);
    }
  };

  useEffect(() => {
    void loadAppointments();
  }, [authenticatedProfile.uid]);
const [messages] = useState<Message[]>(() =>
    readStorage("sanad-messages-v2", initialMessages)
  );

  const [profile, setProfile] = useState<ProfileState>(() => ({
    name: authenticatedProfile.fullName || "",
    phone: authenticatedProfile.phone || "",
    preferredLanguage: authenticatedProfile.preferredLanguage || "English",
    facility: authenticatedProfile.facility || "Kiryandongo Health Centre",
  }));

useEffect(() => {
    try {
      localStorage.setItem("sanad-messages-v2", JSON.stringify(messages));
    } catch {
      console.warn("Unable to save messages locally.");
    }
  }, [messages]);

  const openPage = (nextPage: Page) => {
    setPage(nextPage);
    setMobileMenu(false);
    window.scrollTo({ top: 0, behavior: "smooth" });
  };

  const upcoming = appointments.filter(
    (appointment) =>
      appointment.date >= todayString() &&
      appointment.status !== "cancelled" &&
      appointment.status !== "completed"
  );

  const today = todayString();

  return (
    <div className="min-h-screen bg-[#F4F8FD] text-slate-800">
      {/* MOBILE HEADER */}
      <header className="sticky top-0 z-40 flex items-center justify-between border-b border-slate-100 bg-white px-5 py-4 shadow-sm lg:hidden">
        <Brand />
        <button
          onClick={() => setMobileMenu(!mobileMenu)}
          className="rounded-xl p-2 text-slate-700 transition hover:bg-slate-100"
          aria-label="Toggle navigation"
          aria-expanded={mobileMenu}
        >
          {mobileMenu ? <X size={23} /> : <Menu size={23} />}
        </button>
      </header>

      {/* MOBILE MENU */}
      {mobileMenu && (
        <div className="fixed inset-0 z-50 overflow-y-auto bg-white p-5 lg:hidden">
          <div className="mb-8 flex items-center justify-between">
            <Brand />
            <button
              onClick={() => setMobileMenu(false)}
              className="rounded-xl p-2 hover:bg-slate-100"
              aria-label="Close menu"
            >
              <X size={24} />
            </button>
          </div>

          <p className="mb-3 text-xs font-semibold uppercase tracking-widest text-slate-400">
            Navigation
          </p>
          <NavItems page={page} onNavigate={openPage} />
          <button
            onClick={onSignOut}
            className="mt-5 flex w-full items-center justify-center gap-2 rounded-xl bg-blue-700 px-4 py-3 text-sm font-semibold text-white transition hover:bg-blue-800"
          >
            <span>Log out</span>
          </button>
        </div>
      )}

      <div className="flex min-h-screen">
        {/* DESKTOP SIDEBAR */}
        <aside className="sticky top-0 hidden h-screen w-64 shrink-0 flex-col border-r border-slate-200 bg-white p-6 lg:flex">
          <Brand />

          <p className="mb-3 mt-10 text-xs font-semibold uppercase tracking-widest text-slate-400">
            Main menu
          </p>

          <NavItems page={page} onNavigate={openPage} />
          <button
            onClick={onSignOut}
            className="mt-5 flex w-full items-center justify-center gap-2 rounded-xl bg-blue-700 px-4 py-3 text-sm font-semibold text-white transition hover:bg-blue-800"
          >
            <span>Log out</span>
          </button>

          <div className="mt-auto rounded-2xl bg-[#EAF2FF] p-4">
            <ShieldCheck className="mb-2 text-[#2563EB]" size={22} />
            <p className="text-sm font-semibold text-[#123B73]">
              Your wellbeing matters
            </p>
            <p className="mt-1 text-xs leading-5 text-slate-500">
              Your health, privacy, and dignity are important.
            </p>
          </div>
        </aside>

        {/* MAIN CONTENT */}
        <main className="min-w-0 flex-1">
          <div className="mx-auto max-w-7xl px-4 py-6 pb-28 sm:px-6 lg:px-10 lg:py-9 lg:pb-9">

            {/* ONE PAGE TITLE FOR ALL SCREENS */}
            <div className="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <h1 className="text-2xl font-bold text-slate-800">
                {page}
              </h1>

              <div className="hidden items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-2 sm:flex">
                <div className="flex h-9 w-9 items-center justify-center rounded-full bg-[#DCEBFF] text-[#2563EB]">
                  <UserRound size={18} />
                </div>
                <div>
                  <p className="text-sm font-semibold">
                    {profile.name || "My Profile"}
                  </p>
                  <p className="text-xs text-slate-500">Patient account</p>
                </div>
              </div>
            </div>

            {/* PAGE CONTENT */}
            <div key={page} className="animate-[fadeIn_.3s_ease-out]">
              {page === "Dashboard" && (
                <Dashboard
                  appointments={appointments}
                  upcoming={upcoming}
                  today={today}
                  onNavigate={openPage}
                  name={profile.name}
                />
              )}

              {page === "Appointments" && (
                <AppointmentsPage
                  appointments={appointments}
                  loading={appointmentsLoading}
                  error={appointmentsError}
                  patientUid={authenticatedProfile.uid}
                  assignedWorkerUid={authenticatedProfile.assignedWorkerUid ?? null}
                  onRefresh={loadAppointments}
                />
              )}

              {page === "Reminders" && (
                <RemindersPage appointments={upcoming} />
              )}

              {page === "Messages" && (<MessagesPage patientUid={authenticatedProfile.uid} assignedWorkerUid={authenticatedProfile.assignedWorkerUid ?? null} />)}

              {page === "Health Information" && <HealthPage />}

              {page === "My Profile" && (
                <ProfilePage profile={profile} setProfile={setProfile} />
              )}

              {page === "Referrals" && <ReferralsPage patientUid={authenticatedProfile.uid} />}
              {page === "Notifications" && <NotificationsPage />}
              {page === "Privacy & Consent" && <PrivacyPage />}
              {page === "Help & Support" && <HelpPage />}
              {page === "Settings" && (
                <SettingsPage
                  profile={profile}
                  onSignOut={onSignOut}
                  onNavigate={openPage}
                />
              )}
            </div>
          </div>
        </main>
      </div>

      {/* MOBILE BOTTOM NAVIGATION */}
      <nav className="fixed inset-x-0 bottom-0 z-30 border-t border-slate-200 bg-white px-2 pb-[env(safe-area-inset-bottom)] pt-2 shadow-[0_-4px_20px_rgba(0,0,0,0.04)] lg:hidden">
        <div className="mx-auto flex max-w-lg items-center justify-around">
          {navigation.map(({ name, icon: Icon }) => (
            <button
              key={name}
              onClick={() => openPage(name)}
              className={`flex min-w-0 flex-1 flex-col items-center gap-1 rounded-xl px-1 py-2 text-[10px] font-medium transition ${
                page === name
                  ? "text-[#2563EB]"
                  : "text-slate-400 hover:text-slate-700"
              }`}
              aria-current={page === name ? "page" : undefined}
            >
              <span
                className={`flex h-8 w-9 items-center justify-center rounded-xl transition ${
                  page === name ? "bg-[#DCEBFF]" : ""
                }`}
              >
                <Icon size={19} />
              </span>
              <span className="truncate">{name}</span>
            </button>
          ))}
        </div>
      </nav>
    </div>
  );
}

// ------------------------------------------------------
// BRAND
// ------------------------------------------------------

function Brand() {
  return (
    <div className="flex items-center gap-3">
      <div className="flex h-11 w-11 items-center justify-center rounded-2xl bg-[#2563EB] text-white shadow-sm">
        <Activity size={23} />
      </div>
      <div>
        <p className="text-lg font-bold tracking-tight text-[#123B73]">
          SANAD
        </p>
        <p className="text-xs text-slate-500">CareLink</p>
      </div>
    </div>
  );
}

// ------------------------------------------------------
// NAVIGATION ITEMS
// ------------------------------------------------------

function NavItems({
  page,
  onNavigate,
}: {
  page: Page;
  onNavigate: (page: Page) => void;
}) {
  return (
    <nav className="flex flex-col gap-1">
      {navigation.map(({ name, icon: Icon }) => (
        <button
          key={name}
          onClick={() => onNavigate(name)}
          aria-current={page === name ? "page" : undefined}
          className={`flex items-center gap-3 rounded-xl px-4 py-3 text-left text-sm font-medium transition-all duration-200 ${
            page === name
              ? "bg-[#DCEBFF] text-[#2563EB] shadow-sm"
              : "text-slate-600 hover:bg-slate-50 hover:text-[#2563EB]"
          }`}
        >
          <Icon size={19} />
          <span>{name}</span>
          {page === name && (
            <span className="ml-auto h-2 w-2 rounded-full bg-[#2563EB]" />
          )}
        </button>
      ))}
    </nav>
  );
}

// ------------------------------------------------------
// DASHBOARD
// ------------------------------------------------------

function Dashboard({
  appointments,
  upcoming,
  today,
  onNavigate,
  name,
}: {
  appointments: Appointment[];
  upcoming: Appointment[];
  today: string;
  onNavigate: (page: Page) => void;
  name: string;
}) {
  const next = upcoming
    .slice()
    .sort((a, b) => a.date.localeCompare(b.date))[0];

  return (
    <div className="space-y-6">
      <section className="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#2563EB] to-[#123B73] p-6 text-white shadow-lg sm:p-9">
        <div className="pointer-events-none absolute -right-12 -top-12 h-48 w-48 rounded-full border-[25px] border-white/5" />
        <div className="pointer-events-none absolute -bottom-20 right-20 h-48 w-48 rounded-full bg-white/5" />

        <div className="relative z-10">
          <p className="text-sm font-medium text-white/80">
            Your maternal care companion
          </p>
          <h2 className="mt-2 text-2xl font-bold sm:text-3xl">
            Welcome, {name || "Mama"} 👋
          </h2>
          <p className="mt-3 max-w-xl text-sm leading-6 text-white/90">
            Your care journey matters. Keep track of appointments,
            follow-ups, and connect with your healthcare team.
          </p>
          <button
            onClick={() => onNavigate("Appointments")}
            className="mt-6 inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-semibold text-[#2563EB] transition hover:-translate-y-0.5 hover:bg-[#EAF2FF]"
          >
            <Plus size={18} />
            Manage appointments
            <ArrowRight size={16} />
          </button>
        </div>
      </section>

      <section className="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
        <StatCard
          icon={CalendarDays}
          label="Upcoming appointments"
          value={upcoming.length}
          detail="Visits scheduled"
        />
        <StatCard
          icon={Bell}
          label="Reminders"
          value={upcoming.length}
          detail="Appointments to remember"
        />
        <StatCard
          icon={MessageCircle}
          label="Messages"
          value="Available"
          detail="Demonstration messaging"
        />
      </section>

      <section className="grid gap-6 xl:grid-cols-3">
        <div className={`${cardStyle} xl:col-span-2`}>
          <div className="mb-5 flex items-center justify-between">
            <div>
              <h3 className="font-bold text-slate-800">
                Upcoming appointments
              </h3>
              <p className="mt-1 text-sm text-slate-500">
                Stay connected with your care schedule.
              </p>
            </div>
            <button
              onClick={() => onNavigate("Appointments")}
              className="text-sm font-semibold text-[#2563EB] hover:underline"
            >
              View all
            </button>
          </div>

          {next ? (
            <div className="rounded-2xl bg-[#EAF2FF] p-4 transition hover:bg-[#DCEBFF]">
              <div className="flex gap-4">
                <div className="flex h-14 w-14 shrink-0 flex-col items-center justify-center rounded-xl bg-white text-[#2563EB] shadow-sm">
                  <span className="text-xs font-medium">
                    {new Date(next.date + "T12:00:00").toLocaleString(
                      "en",
                      { month: "short" }
                    )}
                  </span>
                  <span className="text-xl font-bold">
                    {new Date(next.date + "T12:00:00").getDate()}
                  </span>
                </div>
                <div className="min-w-0 flex-1">
                  <p className="font-semibold">{next.title}</p>
                  <p className="mt-1 text-sm text-slate-500">
                    {next.location}
                  </p>
                  <p className="mt-1 flex items-center gap-2 text-sm text-slate-500">
                    <Clock size={14} />
                    {next.time}
                  </p>
                  <span className="mt-2 inline-flex rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-700">
                    Upcoming
                  </span>
                </div>
              </div>
            </div>
          ) : (
            <EmptyState text="You don't have any upcoming appointments." />
          )}
        </div>

        <div className={cardStyle}>
          <h3 className="font-bold">Quick access</h3>
          <div className="mt-4 space-y-2">
            <QuickLink
              icon={MessageCircle}
              label="Message healthcare worker"
              onClick={() => onNavigate("Messages")}
            />
            <QuickLink
              icon={Bell}
              label="View reminders"
              onClick={() => onNavigate("Reminders")}
            />
            <QuickLink
              icon={BookOpen}
              label="Health information"
              onClick={() => onNavigate("Health Information")}
            />
            <QuickLink
              icon={UserRound}
              label="My profile"
              onClick={() => onNavigate("My Profile")}
            />
          </div>
        </div>
      </section>

      <section className={cardStyle}>
        <div className="flex items-center gap-3">
          <div className="flex h-11 w-11 items-center justify-center rounded-xl bg-[#EAF2FF] text-[#2563EB]">
            <HeartPulse size={22} />
          </div>
          <div>
            <h3 className="font-bold">Your care overview</h3>
            <p className="text-sm text-slate-500">
              A summary of your appointments.
            </p>
          </div>
        </div>
        <div className="mt-5 flex flex-wrap gap-3">
          <OverviewItem label="Total visits" value={appointments.length} />
          <OverviewItem
            label="Today"
            value={appointments.filter((a) => a.date === today).length}
          />
          <OverviewItem label="Upcoming" value={upcoming.length} />
        </div>
      </section>
    </div>
  );
}

// ------------------------------------------------------
// REUSABLE COMPONENTS
// ------------------------------------------------------

function StatCard({
  icon: Icon,
  label,
  value,
  detail,
}: {
  icon: typeof Activity;
  label: string;
  value: string | number;
  detail: string;
}) {
  return (
    <div className={`${cardStyle} hover:-translate-y-1`}>
      <div className="flex items-center gap-3">
        <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#EAF2FF] text-[#2563EB]">
          <Icon size={21} />
        </div>
        <div className="text-sm text-slate-500">{label}</div>
      </div>
      <p className="mt-4 text-2xl font-bold text-slate-800">{value}</p>
      <p className="mt-1 text-xs text-slate-500">{detail}</p>
    </div>
  );
}

function OverviewItem({ label, value }: { label: string; value: number }) {
  return (
    <div className="min-w-28 rounded-xl bg-slate-50 px-4 py-3">
      <p className="text-xs text-slate-500">{label}</p>
      <p className="mt-1 text-xl font-bold text-[#2563EB]">{value}</p>
    </div>
  );
}

function QuickLink({
  icon: Icon,
  label,
  onClick,
}: {
  icon: typeof Activity;
  label: string;
  onClick: () => void;
}) {
  return (
    <button
      onClick={onClick}
      className="flex w-full items-center gap-3 rounded-xl border border-slate-100 p-3 text-left text-sm transition hover:border-[#DCEBFF] hover:bg-[#EAF2FF]"
    >
      <Icon size={18} className="text-[#2563EB]" />
      <span className="flex-1">{label}</span>
      <ChevronRight size={17} className="text-slate-400" />
    </button>
  );
}

function EmptyState({ text }: { text: string }) {
  return (
    <div className="rounded-xl bg-slate-50 p-5 text-center text-sm text-slate-500">
      {text}
    </div>
  );
}

function FormField({
  label,
  children,
}: {
  label: string;
  children: React.ReactNode;
}) {
  return (
    <label className="block space-y-2">
      <span className="text-sm font-medium text-slate-700">{label}</span>
      {children}
    </label>
  );
}

// ------------------------------------------------------
// APPOINTMENTS
// ------------------------------------------------------

function AppointmentsPage({
  appointments,
  loading,
  error,
  patientUid,
  assignedWorkerUid,
  onRefresh,
}: {
  appointments: Appointment[];
  loading: boolean;
  error: string;
  patientUid: string;
  assignedWorkerUid: string | null;
  onRefresh: () => Promise<void>;
}) {
  const [showForm, setShowForm] = useState(false);
  const [title, setTitle] = useState("Antenatal Care Visit");
  const [date, setDate] = useState("");
  const [time, setTime] = useState("09:00");
  const [location, setLocation] = useState("Kiryandongo Health Centre");
  const [saving, setSaving] = useState(false);
  const [actionError, setActionError] = useState("");

  const addAppointment = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!title.trim() || !date || !time || !location.trim()) return;

    try {
      setSaving(true);
      setActionError("");

      await createAppointment({
        patientUid,
        assignedWorkerUid,
        title: title.trim(),
        date,
        time,
        location: location.trim(),
      });

      await onRefresh();
      setTitle("Antenatal Care Visit");
      setDate("");
      setTime("09:00");
      setLocation("Kiryandongo Health Centre");
      setShowForm(false);
    } catch (error) {
      console.error("Unable to create appointment:", error);
      setActionError(
        error instanceof Error ? error.message : "Unable to submit appointment."
      );
    } finally {
      setSaving(false);
    }
  };

  const cancelAppointment = async (id: string) => {
    if (!window.confirm("Are you sure you want to cancel this appointment?")) return;

    try {
      setActionError("");
      await updateAppointmentStatus(id, "cancelled");
      await onRefresh();
    } catch (error) {
      console.error("Unable to cancel appointment:", error);
      setActionError(
        error instanceof Error ? error.message : "Unable to cancel appointment."
      );
    }
  };

  const sortedAppointments = appointments
    .slice()
    .sort((a, b) => a.date.localeCompare(b.date));

  const statusLabel: Record<Appointment["status"], string> = {
    pending: "Awaiting confirmation",
    scheduled: "Confirmed",
    completed: "Completed",
    cancelled: "Cancelled",
  };

  return (
    <div className="space-y-6">
      <div className="flex flex-wrap items-center justify-between gap-3">
        <p className="text-sm text-slate-500">
          Keep track of your maternal care visits.
        </p>
        <button
          onClick={() => setShowForm(!showForm)}
          className={primaryButtonStyle}
          disabled={saving}
        >
          <Plus size={18} />
          New appointment
        </button>
      </div>

      {(error || actionError) && (
        <div className="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
          {actionError || error}
        </div>
      )}

      {showForm && (
        <form onSubmit={addAppointment} className={`${cardStyle} space-y-4`}>
          <h3 className="font-bold">Request an appointment</h3>
          <div className="grid gap-4 sm:grid-cols-2">
            <FormField label="Appointment type">
              <input required value={title} onChange={(e) => setTitle(e.target.value)}
                className={inputStyle} placeholder="e.g. Antenatal visit" />
            </FormField>
            <FormField label="Facility">
              <input required value={location} onChange={(e) => setLocation(e.target.value)}
                className={inputStyle} />
            </FormField>
            <FormField label="Date">
              <input required type="date" min={todayString()} value={date}
                onChange={(e) => setDate(e.target.value)} className={inputStyle} />
            </FormField>
            <FormField label="Time">
              <input required type="time" value={time}
                onChange={(e) => setTime(e.target.value)} className={inputStyle} />
            </FormField>
          </div>
          <div className="flex flex-wrap gap-2">
            <button type="submit" className={primaryButtonStyle} disabled={saving}>
              <CheckCircle2 size={17} />
              {saving ? "Submitting..." : "Submit request"}
            </button>
            <button type="button" onClick={() => setShowForm(false)} disabled={saving}
              className="rounded-xl bg-slate-100 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-200">
              Cancel
            </button>
          </div>
        </form>
      )}

      <div className="space-y-3">
        {loading ? (
          <EmptyState text="Loading your appointments..." />
        ) : sortedAppointments.length === 0 ? (
          <EmptyState text="No appointments yet. Add your first appointment above." />
        ) : (
          sortedAppointments.map((appointment) => (
            <div key={appointment.id}
              className={`${cardStyle} flex flex-wrap items-center gap-4`}>
              <div className="flex h-14 w-14 shrink-0 flex-col items-center justify-center rounded-xl bg-[#EAF2FF] text-[#2563EB]">
                <span className="text-xs">
                  {new Date(appointment.date + "T12:00:00").toLocaleString("en", { month: "short" })}
                </span>
                <span className="text-xl font-bold">
                  {new Date(appointment.date + "T12:00:00").getDate()}
                </span>
              </div>
              <div className="min-w-0 flex-1">
                <p className="font-semibold">{appointment.title}</p>
                <p className="mt-1 text-sm text-slate-500">{appointment.location}</p>
                <p className="mt-1 flex items-center gap-2 text-sm text-slate-500">
                  <Clock size={14} />
                  {appointment.time}
                </p>
                <div className="mt-2">
                  <span className={`inline-flex rounded-full px-3 py-1 text-xs font-semibold ${
                    appointment.status === "scheduled"
                      ? "bg-green-100 text-green-700"
                      : appointment.status === "cancelled"
                        ? "bg-red-100 text-red-700"
                        : appointment.status === "completed"
                          ? "bg-slate-100 text-slate-600"
                          : "bg-amber-100 text-amber-700"
                  }`}>
                    {statusLabel[appointment.status]}
                  </span>
                </div>
              </div>
              {appointment.status !== "cancelled" && appointment.status !== "completed" && (
                <button onClick={() => void cancelAppointment(appointment.id)}
                  className="rounded-lg p-2 text-slate-400 transition hover:bg-red-50 hover:text-red-600"
                  title="Cancel appointment" aria-label={`Cancel ${appointment.title}`}>
                  <Trash2 size={18} />
                </button>
              )}
            </div>
          ))
        )}
      </div>

    </div>
  );
}

