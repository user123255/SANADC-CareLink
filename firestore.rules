
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------
    // AUTHENTICATION AND ROLE HELPERS
    // --------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isPatient() {
      return hasProfile() &&
        myProfile().role == "patient" &&
        myProfile().accountStatus == "active";
    }

    function isWorker() {
      return hasProfile() &&
        myProfile().role == "healthWorker" &&
        myProfile().accountStatus == "active";
    }

    function isAdmin() {
      return hasProfile() &&
        myProfile().role == "admin" &&
        myProfile().accountStatus == "active";
    }

    function isAssignedWorker(patientUid) {
      return isWorker() &&
        exists(/databases/$(database)/documents/users/$(patientUid)) &&
        get(
          /databases/$(database)/documents/users/$(patientUid)
        ).data.assignedWorkerUid == request.auth.uid;
    }

    // --------------------------------------------------
    // USER PROFILES
    // --------------------------------------------------

    match /users/{userId} {

      // A user can read their own profile.
      // Administrators can read all profiles.
      allow get: if signedIn() &&
        (request.auth.uid == userId || isAdmin());

      allow list: if isAdmin() || (
  isWorker() &&
  resource.data.role == "patient" &&
  resource.data.assignedWorkerUid == request.auth.uid &&
  resource.data.accountStatus == "active"
);

      // Public self-registration is restricted to patients.
      // Administrator and healthcare-worker profiles must
      // be provisioned through trusted authorization.
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.role == "patient" &&
        request.resource.data.accountStatus == "active" &&
        request.resource.data.assignedWorkerUid == null &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 2 &&
        request.resource.data.fullName.size() <= 120 &&
        request.resource.data.facility is string &&
        request.resource.data.facility.size() >= 2 &&
        request.resource.data.phone is string &&
        request.resource.data.preferredLanguage is string &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.keys().hasOnly([
          "uid",
          "fullName",
          "email",
          "role",
          "phone",
          "preferredLanguage",
          "facility",
          "assignedWorkerUid",
          "accountStatus",
          "createdAt",
          "updatedAt"
        ]);

      // Patients can update only their basic profile information.
      // Administrators can assign or unassign a healthcare worker.
      allow update: if (
        signedIn() &&
        request.auth.uid == userId &&
        resource.data.role == "patient" &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.accountStatus == resource.data.accountStatus &&
        request.resource.data.assignedWorkerUid == resource.data.assignedWorkerUid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "fullName",
            "phone",
            "preferredLanguage",
            "facility",
            "updatedAt"
          ])
      ) || (
        isAdmin() &&
        resource.data.role == "patient" &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.accountStatus == resource.data.accountStatus &&
        (
          request.resource.data.assignedWorkerUid == null ||
          (
            request.resource.data.assignedWorkerUid is string &&
            exists(
              /databases/$(database)/documents/users/$(request.resource.data.assignedWorkerUid)
            ) &&
            get(
              /databases/$(database)/documents/users/$(request.resource.data.assignedWorkerUid)
            ).data.role == "healthWorker" &&
            get(
              /databases/$(database)/documents/users/$(request.resource.data.assignedWorkerUid)
            ).data.accountStatus == "active"
          )
        ) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["assignedWorkerUid", "updatedAt"])
      );

      // User profiles cannot be deleted through the client.
      allow delete: if false;
    }

    // --------------------------------------------------
    // STAFF APPLICATIONS
    // --------------------------------------------------

    match /staffApplications/{applicationId} {

      allow get: if signedIn() && (
        request.auth.uid == applicationId ||
        isAdmin()
      );

      allow list: if isAdmin();

      // Anyone applying for staff access can only request
      // healthcare-worker status, never administrator status.
      allow create: if signedIn() &&
        request.auth.uid == applicationId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.requestedRole == "healthWorker" &&
        request.resource.data.status == "pending" &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 2 &&
        request.resource.data.fullName.size() <= 120 &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.facility is string &&
        request.resource.data.facility.size() >= 2 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.keys().hasOnly([
          "uid",
          "fullName",
          "email",
          "requestedRole",
          "facility",
          "status",
          "createdAt",
          "updatedAt"
        ]);

      // Approval and rejection must be performed by trusted backend code.
      allow update, delete: if false;
    }

    // --------------------------------------------------
    // APPOINTMENTS
    // --------------------------------------------------

    match /appointments/{appointmentId} {
            allow read: if signedIn() && (
        isAdmin() ||
        resource.data.patientUid == request.auth.uid ||
        resource.data.assignedWorkerUid == request.auth.uid
      );
      
      allow create: if signedIn() &&
        request.resource.data.patientUid is string &&
        (
          isAdmin() ||
          (
            isPatient() &&
            request.resource.data.patientUid == request.auth.uid &&
            request.resource.data.assignedWorkerUid ==
              myProfile().assignedWorkerUid &&
            request.resource.data.status == "pending"
          ) ||
          (
            isWorker() &&
            request.resource.data.assignedWorkerUid == request.auth.uid &&
            isAssignedWorker(request.resource.data.patientUid) &&
            request.resource.data.status == "scheduled"
          )
        );

      allow update: if signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "updatedAt"]) &&
        (
          isAdmin() ||
          (
            isWorker() &&
            resource.data.assignedWorkerUid == request.auth.uid &&
            request.resource.data.status in [
              "scheduled",
              "completed",
              "cancelled"
            ]
          ) ||
          (
            isPatient() &&
            resource.data.patientUid == request.auth.uid &&
            request.resource.data.status == "cancelled"
          )
        );

      allow delete: if isAdmin();
    }

    // --------------------------------------------------
    // CONVERSATIONS
    // --------------------------------------------------

    match /conversations/{conversationId} {

      function isConversationParticipant() {
        return signedIn() &&
          request.auth.uid in resource.data.participantUids;
      }

      allow get, list: if signedIn() && (
        isAdmin() ||
        resource.data.patientUid == request.auth.uid ||
        resource.data.assignedWorkerUid == request.auth.uid
      );

      allow create: if signedIn() &&
        request.resource.data.patientUid is string &&
        request.resource.data.assignedWorkerUid is string &&
        request.resource.data.participantUids.size() == 2 &&
        request.auth.uid in request.resource.data.participantUids &&
        request.resource.data.status == "active" &&
        request.resource.data.lastMessageText == "" &&
        request.resource.data.lastMessageAt == null &&
        (
          (
            isPatient() &&
            request.resource.data.patientUid == request.auth.uid &&
            request.resource.data.assignedWorkerUid ==
              myProfile().assignedWorkerUid &&
            request.resource.data.participantUids.hasAll([
              request.auth.uid,
              myProfile().assignedWorkerUid
            ])
          ) ||
          (
            isWorker() &&
            request.resource.data.assignedWorkerUid == request.auth.uid &&
            isAssignedWorker(request.resource.data.patientUid) &&
            request.resource.data.participantUids.hasAll([
              request.resource.data.patientUid,
              request.auth.uid
            ])
          )
        );

      // Participants may update message preview information only.
      allow update: if isConversationParticipant() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "lastMessageText",
            "lastMessageAt",
            "lastMessageSenderUid",
            "updatedAt"
          ]);

      allow delete: if isAdmin();

      // ------------------------------------------------
      // CONVERSATION MESSAGES
      // ------------------------------------------------

      match /messages/{messageId} {

        function conversationData() {
          return get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data;
        }

        function isParticipant() {
          return signedIn() &&
            request.auth.uid in conversationData().participantUids &&
            conversationData().status == "active";
        }

        allow read: if isParticipant() || isAdmin();

        allow create: if isParticipant() &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 4000 &&
          (
            (
              isPatient() &&
              conversationData().patientUid == request.auth.uid &&
              request.resource.data.senderRole == "patient"
            ) ||
            (
              isWorker() &&
              conversationData().assignedWorkerUid == request.auth.uid &&
              request.resource.data.senderRole == "healthWorker"
            )
          );

        // Only the recipient can mark a message as read.
        allow update: if isParticipant() &&
          resource.data.senderUid != request.auth.uid &&
          resource.data.readAt == null &&
          request.resource.data.readAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["readAt"]);

        allow delete: if isAdmin();
      }
    }

    // --------------------------------------------------
    // REFERRALS
    // --------------------------------------------------

    match /referrals/{referralId} {

      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.patientUid == request.auth.uid ||
        resource.data.assignedWorkerUid == request.auth.uid
      );

      allow create: if (
        isWorker() &&
        request.resource.data.assignedWorkerUid == request.auth.uid &&
        request.resource.data.createdByUid == request.auth.uid &&
        isAssignedWorker(request.resource.data.patientUid) &&
        request.resource.data.status == "pending"
      ) || (
        isAdmin() &&
        request.resource.data.status == "pending"
      );

      allow update: if (
        isAdmin() ||
        (
          isWorker() &&
          resource.data.assignedWorkerUid == request.auth.uid
        )
      ) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "updatedAt"]) &&
        request.resource.data.status in [
          "pending",
          "accepted",
          "completed",
          "cancelled"
        ];

      allow delete: if isAdmin();
    }

    // --------------------------------------------------
    // REMINDERS
    // --------------------------------------------------

    match /reminders/{reminderId} {

      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.patientUid == request.auth.uid ||
        resource.data.assignedWorkerUid == request.auth.uid
      );

      allow create: if isWorker() &&
        request.resource.data.assignedWorkerUid == request.auth.uid &&
        request.resource.data.createdByUid == request.auth.uid &&
        isAssignedWorker(request.resource.data.patientUid) &&
        request.resource.data.status == "pending";

      allow update: if signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "updatedAt"]) &&
        (
          (
            isPatient() &&
            resource.data.patientUid == request.auth.uid &&
            request.resource.data.status == "read"
          ) ||
          (
            isWorker() &&
            resource.data.assignedWorkerUid == request.auth.uid &&
            request.resource.data.status in [
              "read",
              "cancelled",
              "completed"
            ]
          ) ||
          isAdmin()
        );

      allow delete: if isAdmin();
    }

    // --------------------------------------------------
    // NOTIFICATIONS
    // --------------------------------------------------

    match /notifications/{notificationId} {

      allow get, list: if signedIn() && (
        isAdmin() ||
        resource.data.userUid == request.auth.uid
      );

      allow create: if (
        isAdmin() &&
        request.resource.data.userUid is string
      ) || (
        isWorker() &&
        request.resource.data.userUid is string &&
        isAssignedWorker(request.resource.data.userUid)
      );

      allow update: if signedIn() &&
        resource.data.userUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["read", "readAt", "updatedAt"]);

      allow delete: if isAdmin();
    }

    // --------------------------------------------------
    // HEALTH INFORMATION
    // --------------------------------------------------

    match /healthContent/{contentId} {

      allow read: if signedIn() && (
        resource.data.status == "approved" ||
        (
          isAdmin() &&
          resource.data.createdByUid == request.auth.uid
        )
      );

      allow create: if isAdmin() &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.status == "draft";

      allow update: if isAdmin() &&
        resource.data.status != "approved" &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "title",
            "description",
            "body",
            "category",
            "updatedAt"
          ]);

      allow delete: if isAdmin();
    }

    // --------------------------------------------------
    // CONSENT RECORDS
    // --------------------------------------------------

    match /consents/{consentId} {

      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.userUid == request.auth.uid
      );

      allow create: if isPatient() &&
        request.resource.data.userUid == request.auth.uid &&
        request.resource.data.status == "granted";

      allow update: if isPatient() &&
        resource.data.userUid == request.auth.uid &&
        resource.data.status == "granted" &&
        request.resource.data.status == "withdrawn" &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "withdrawnAt"]);

      allow delete: if false;
    }

    // --------------------------------------------------
    // AUDIT LOGS
    // --------------------------------------------------

    match /auditLogs/{logId} {

      allow read: if isAdmin();

      // Trusted server-side code only.
      allow create, update, delete: if false;
    }

    // --------------------------------------------------
    // DENY EVERYTHING NOT EXPLICITLY ALLOWED
    // --------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
