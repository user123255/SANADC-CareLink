rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isPatient() {
      return hasProfile() &&
        myProfile().role == "patient" &&
        myProfile().accountStatus == "active";
    }

    function isWorker() {
      return hasProfile() &&
        myProfile().role == "healthWorker" &&
        myProfile().accountStatus == "active";
    }

    function isAdmin() {
      return hasProfile() &&
        myProfile().role == "admin" &&
        myProfile().accountStatus == "active";
    }

    function isAssignedWorker(patientUid) {
      return isWorker() &&
        get(/databases/$(database)/documents/users/$(patientUid)).data.assignedWorkerUid
          == request.auth.uid;
    }

    function isConversationParticipant() {
      return signedIn() &&
        request.auth.uid in resource.data.participantUids;
    }

    // USER PROFILES
    match /users/{userId} {

      // Users can read their own profiles.
      // Workers can read patients assigned to them.
      // Authenticated staff can read other staff profiles.
      allow get: if signedIn() && (
        request.auth.uid == userId ||
        (
          isWorker() &&
          resource.data.role == "patient" &&
          resource.data.assignedWorkerUid == request.auth.uid
        ) ||
        (
          (isWorker() || isAdmin()) &&
          resource.data.role in ["healthWorker", "admin"]
        )
      );

      // Workers can query only their assigned active patients.
      allow list: if isWorker() &&
        resource.data.role == "patient" &&
        resource.data.assignedWorkerUid == request.auth.uid &&
        resource.data.accountStatus == "active";

      // Public registration can create patient accounts only.
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.role == "patient" &&
        request.resource.data.accountStatus == "active" &&
        request.resource.data.keys().hasOnly([
          "uid",
          "fullName",
          "email",
          "role",
          "phone",
          "preferredLanguage",
          "facility",
          "assignedWorkerUid",
          "accountStatus",
          "createdAt",
          "updatedAt"
        ]) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      // Patients can update permitted profile fields only.
      allow update: if signedIn() &&
        request.auth.uid == userId &&
        resource.data.role == "patient" &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.accountStatus == resource.data.accountStatus &&
        request.resource.data.assignedWorkerUid == resource.data.assignedWorkerUid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "fullName",
            "phone",
            "preferredLanguage",
            "facility",
            "updatedAt"
          ]);

      // No client-side account deletion or role changes.
      allow delete: if false;
    }


    // STAFF ACCOUNT APPLICATIONS
    match /staffApplications/{applicationId} {

      // Applicants can read their own application.
      // Active administrators can read applications for review.
      allow get: if signedIn() && (
        request.auth.uid == applicationId ||
        isAdmin()
      );

      allow list: if isAdmin();

      // Applicants may submit an application for staff access.
      // This does not grant them any staff privileges.
      allow create: if signedIn() &&
        request.auth.uid == applicationId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.requestedRole in [
          "healthWorker",
          "admin"
        ] &&
        request.resource.data.status == "pending" &&
        request.resource.data.keys().hasOnly([
          "uid",
          "fullName",
          "email",
          "requestedRole",
          "facility",
          "status",
          "createdAt",
          "updatedAt"
        ]) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      // Approval and rejection must happen through trusted backend code.
      allow update, delete: if false;
    }


    // APPOINTMENTS
    match /appointments/{appointmentId} {

      allow read: if signedIn() && (
        resource.data.patientUid == request.auth.uid ||
        resource.data.assignedWorkerUid == request.auth.uid
      );

      allow create: if signedIn() &&
        request.resource.data.status == "scheduled" &&
        request.resource.data.patientUid is string &&
        (
          (
            isPatient() &&
            request.resource.data.patientUid == request.auth.uid &&
            request.resource.data.assignedWorkerUid ==
              myProfile().assignedWorkerUid
          ) ||
          (
            isWorker() &&
            request.resource.data.assignedWorkerUid == request.auth.uid &&
            isAssignedWorker(request.resource.data.patientUid)
          )
        );

      allow update: if signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "updatedAt"]) &&
        (
          (
            isWorker() &&
            resource.data.assignedWorkerUid == request.auth.uid &&
            request.resource.data.status in [
              "scheduled", "completed", "cancelled"
            ]
          ) ||
          (
            isPatient() &&
            resource.data.patientUid == request.auth.uid &&
            request.resource.data.status == "cancelled"
          )
        );

      allow delete: if false;
    }

    // CONVERSATIONS
    match /conversations/{conversationId} {

      allow get, list: if signedIn() && (
        resource.data.patientUid == request.auth.uid ||
        resource.data.assignedWorkerUid == request.auth.uid
      );

      allow create: if signedIn() &&
        request.resource.data.patientUid is string &&
        request.resource.data.assignedWorkerUid is string &&
        request.resource.data.participantUids.size() == 2 &&
        request.auth.uid in request.resource.data.participantUids &&
        request.resource.data.status == "active" &&
        request.resource.data.lastMessageText == "" &&
        request.resource.data.lastMessageAt == null &&
        (
          (
            isPatient() &&
            request.resource.data.patientUid == request.auth.uid &&
            request.resource.data.assignedWorkerUid ==
              myProfile().assignedWorkerUid &&
            request.resource.data.participantUids.hasAll([
              request.auth.uid,
              myProfile().assignedWorkerUid
            ])
          ) ||
          (
            isWorker() &&
            request.resource.data.assignedWorkerUid == request.auth.uid &&
            isAssignedWorker(request.resource.data.patientUid) &&
            request.resource.data.participantUids.hasAll([
              request.resource.data.patientUid,
              request.auth.uid
            ])
          )
        );

      allow update, delete: if false;

      // CONVERSATION MESSAGES
      match /messages/{messageId} {

        function conversationData() {
          return get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data;
        }

        function isParticipant() {
          return signedIn() &&
            request.auth.uid in conversationData().participantUids &&
            conversationData().status == "active";
        }

        allow read: if isParticipant();

        allow create: if isParticipant() &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 4000 &&
          (
            (
              isPatient() &&
              conversationData().patientUid == request.auth.uid &&
              request.resource.data.senderRole == "patient"
            ) ||
            (
              isWorker() &&
              conversationData().assignedWorkerUid == request.auth.uid &&
              request.resource.data.senderRole == "healthWorker"
            )
          );

        // Only the recipient can mark a message as read.
        allow update: if isParticipant() &&
          resource.data.senderUid != request.auth.uid &&
          resource.data.readAt == null &&
          request.resource.data.readAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["readAt"]);

        allow delete: if false;
      }
    }

    // REFERRALS
    match /referrals/{referralId} {

      allow read: if signedIn() && (
        resource.data.patientUid == request.auth.uid ||
        resource.data.assignedWorkerUid == request.auth.uid
      );

      allow create: if isWorker() &&
        request.resource.data.assignedWorkerUid == request.auth.uid &&
        request.resource.data.createdByUid == request.auth.uid &&
        isAssignedWorker(request.resource.data.patientUid) &&
        request.resource.data.status == "pending";

      allow update: if isWorker() &&
        resource.data.assignedWorkerUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "updatedAt"]) &&
        request.resource.data.status in [
          "pending", "accepted", "completed", "cancelled"
        ];

      allow delete: if false;
    }

    // REMINDERS
    match /reminders/{reminderId} {

      allow read: if signedIn() && (
        resource.data.patientUid == request.auth.uid ||
        resource.data.assignedWorkerUid == request.auth.uid
      );

      allow create: if isWorker() &&
        request.resource.data.assignedWorkerUid == request.auth.uid &&
        request.resource.data.createdByUid == request.auth.uid &&
        isAssignedWorker(request.resource.data.patientUid) &&
        request.resource.data.status == "pending";

      allow update: if signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "updatedAt"]) &&
        (
          (
            isPatient() &&
            resource.data.patientUid == request.auth.uid &&
            request.resource.data.status == "read"
          ) ||
          (
            isWorker() &&
            resource.data.assignedWorkerUid == request.auth.uid &&
            request.resource.data.status in ["read", "cancelled"]
          )
        );

      allow delete: if false;
    }

    // HEALTH INFORMATION
    match /healthContent/{contentId} {

      // Signed-in users can read approved content.
      // Administrators can also read drafts they created.
      allow read: if signedIn() && (
        resource.data.status == "approved" ||
        (
          isAdmin() &&
          resource.data.createdByUid == request.auth.uid
        )
      );

      // Administrators can create drafts.
      allow create: if isAdmin() &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.status == "draft";

      // Admins can edit content, but cannot publish or approve it.
      allow update: if isAdmin() &&
        resource.data.status != "approved" &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "title",
            "description",
            "body",
            "category",
            "updatedAt"
          ]);

      allow delete: if false;
    }

    // CONSENT RECORDS
    match /consents/{consentId} {

      allow read: if signedIn() &&
        resource.data.userUid == request.auth.uid;

      allow create: if isPatient() &&
        request.resource.data.userUid == request.auth.uid &&
        request.resource.data.status == "granted";

      allow update: if isPatient() &&
        resource.data.userUid == request.auth.uid &&
        resource.data.status == "granted" &&
        request.resource.data.status == "withdrawn" &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "withdrawnAt"]);

      allow delete: if false;
    }

    // AUDIT LOGS
    match /auditLogs/{logId} {

      allow read: if isAdmin();

      // Only trusted server-side functions may write audit logs.
      allow create, update, delete: if false;
    }
  }
}

